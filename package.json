{
  "name": "slotify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --env-file=.env tests/auth-stage41.mjs",
    "test:reservations": "node --env-file=.env --import tsx tests/reservations-stage5a.mjs",
    "test:notifications": "node --env-file=.env tests/notifications-stage5e.mjs",
    "test:departments": "node --env-file=.env --import tsx tests/departments-stage6a.mjs",
    "test:stage6b": "node --env-file=.env tests/departments-stage6b.mjs",
    "format": "prettier --write .",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:seed-departments": "node --env-file=.env --import tsx prisma/seed-departments.ts",
    "db:client:refresh": "prisma generate && prisma migrate status && node -e \"console.log('Restart the Next.js dev server to reload the generated Prisma Client.')\"",
    "db:setup-demo": "node --import tsx prisma/setup-demo-credentials.ts",
    "db:reset-demo-password": "node --env-file=.env --import tsx prisma/reset-demo-password.ts",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.30",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node --env-file=.env --import tsx prisma/seed.ts"
  }
}
