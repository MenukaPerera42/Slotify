datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  RESERVATION_REQUESTED
  RESERVATION_APPROVED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
}

enum OfficeShiftMode {
  MORNING
  EVENING
  NIGHT
  FULL_DAY
  CUSTOM
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  firstName    String?
  lastName     String?
  email        String        @unique
  role         UserRole      @default(MEMBER)
  passwordHash String?
  isActive     Boolean       @default(true)
  departmentId String?       @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  reservations        Reservation[] @relation("ReservationOwner")
  createdReservations Reservation[] @relation("ReservationCreator")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  actedNotifications    Notification[] @relation("NotificationActor")
  departmentCorrections ReservationDepartmentCorrection[] @relation("DepartmentCorrectionActor")
  updatedOfficeShifts OfficeShift[] @relation("OfficeShiftUpdater")
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@map("users")
}

model OfficeShift {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @unique
  mode            OfficeShiftMode
  description     String?
  startMinute     Int
  durationMinutes Int
  isActive        Boolean         @default(false)
  updatedByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  updatedBy       User?           @relation("OfficeShiftUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("office_shifts")
}

model Department {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  code         String        @unique
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  users        User[]
  reservations Reservation[]
  previousCorrections ReservationDepartmentCorrection[] @relation("PreviousCorrectionDepartment")
  newCorrections ReservationDepartmentCorrection[] @relation("NewCorrectionDepartment")

  @@index([isActive])
  @@map("departments")
}

model AuthRateLimit {
  key      String   @id
  attempts Int
  resetAt  DateTime @db.Timestamptz(3)

  @@index([resetAt])
  @@map("auth_rate_limits")
}

model ResourceCategory {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  resources   Resource[]

  @@map("resource_categories")
}

model Resource {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  categoryId   String           @db.Uuid
  location     String
  capacity     Int?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  category     ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([categoryId])
  @@index([isActive])
  @@map("resources")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  resourceId String            @db.Uuid
  userId     String?           @db.Uuid
  departmentId String?         @db.Uuid
  createdByUserId String?       @db.Uuid
  title      String
  startTime  DateTime          @db.Timestamptz(3)
  endTime    DateTime          @db.Timestamptz(3)
  status     ReservationStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  resource   Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  user       User?             @relation("ReservationOwner", fields: [userId], references: [id], onDelete: Restrict)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy  User?             @relation("ReservationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  notifications Notification[]
  departmentCorrections ReservationDepartmentCorrection[]

  @@index([resourceId, startTime, endTime])
  @@index([userId])
  @@index([userId, startTime])
  @@index([departmentId, startTime])
  @@index([createdByUserId])
  @@index([status])
  @@map("reservations")
}

model ReservationDepartmentCorrection {
  id                   String     @id @default(uuid()) @db.Uuid
  reservationId        String     @db.Uuid
  previousDepartmentId String?    @db.Uuid
  newDepartmentId      String     @db.Uuid
  correctedByUserId    String     @db.Uuid
  reason               String
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  reservation          Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  previousDepartment   Department? @relation("PreviousCorrectionDepartment", fields: [previousDepartmentId], references: [id], onDelete: Restrict)
  newDepartment        Department @relation("NewCorrectionDepartment", fields: [newDepartmentId], references: [id], onDelete: Restrict)
  correctedBy          User       @relation("DepartmentCorrectionActor", fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@index([reservationId, createdAt])
  @@index([correctedByUserId])
  @@map("reservation_department_corrections")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  recipientUserId String           @db.Uuid
  actorUserId     String?          @db.Uuid
  reservationId   String?          @db.Uuid
  type            NotificationType
  title           String
  message         String
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  readAt          DateTime?        @db.Timestamptz(3)

  recipient   User         @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor       User?        @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, isRead, createdAt(sort: Desc)])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([reservationId])
  @@index([actorUserId])
  @@map("notifications")
}
