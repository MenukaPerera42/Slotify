# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slotify?schema=public"

# Next.js Application Environment
NEXT_PUBLIC_APP_NAME="Slotify"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Local seed credentials only. Choose different strong values; keep them in ignored .env.
SLOTIFY_DEMO_ADMIN_PASSWORD=""
SLOTIFY_DEMO_MEMBER_PASSWORD=""

